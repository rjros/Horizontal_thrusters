          <mesh>
            <scale>1 1 1</scale>
            <uri>model://torsional_quad/meshes/edf_housing.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="edf_2_collision">
        <pose>0 0 0 0 0 0 </pose>
        <geometry>
          <box>
            <size>0.01 0.01 0.01</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="edf_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>edf_2_body</child>
      <pose> 0 0 0 0 0 0 </pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.145159</lower>
          <upper>3.145159</upper>
        </limit>
        <dynamics>
          <friction>1.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_6">
        <gravity>true</gravity>
        <self_collide>false</self_collide>
        <velocity_decay/>
        <pose>-0.53050 0 0.025 0 1.57 0</pose>
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>3.9146e-06</ixx>
            <iyy>3.9146e-06</iyy>
            <izz>7.8125e-06</izz>
          </inertia>
        </inertial>
       <visual name="rotor_6_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://torsional_quad/meshes/edf_impeler.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="rotor_6_collision">
        <pose>0 0 0 0 0 0 </pose>
        <geometry>
          <box>
            <size>0.0008461538461538462 0.016923076923076923 0.004</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rotor_6_joint" type="revolute">
      <parent>edf_2_body</parent>
      <child>rotor_6</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <!-- EDF END -->

