<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_dual_400_torque'>
<!-- FORCE SENSOR BASE -->
   <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <link name="sensor_link">
     <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>500</mass>
        <inertia>
          <ixx>0.0411</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0411</iyy>
          <iyz>0</iyz>
          <izz>0.0411</izz>
        </inertia>
      </inertial>
      <visual name="sensor_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_dual_400/meshes/sensor_base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Collision definition -->
      <collision name="sensor_link_collision">
         <geometry>
          <mesh>
            <uri>model://x500_dual_400/meshes/sensor_base.dae</uri>
          </mesh>
        </geometry>
      </collision>
      </link>
<!-- FORCE SENSOR BASE END -->
<!-- UAV FRAME  -->
    <link name="base_link">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0 0 0.395 0 0 1.57</pose>
     <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0013</ixx>
          <iyy>0.0013</iyy>
          <izz>0.0025</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_dual_400/meshes/uav_frame_x500.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Collision definition -->
      <collision name="base_link_collision">
        <pose> 0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.05 </size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
     <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
      </sensor>
    </link>

    <!-- Sensors and main frame END -->
    <joint name="uav_frame_joint" type="fixed">
      <parent>sensor_link</parent>
      <child>base_link</child>
      <pose> 0 0 -0.016 0 0 0 </pose>
        <sensor name= 'force_sensor' type='force_torque'>
            <always_on>true</always_on>
            <update_rate>100.0</update_rate>
            <visualize>true</visualize>
            <force_torque>
                <frame>sensor</frame>
                <measure_direction>child_to_parent</measure_direction>
            </force_torque>
            <topic>/wrench</topic>
        </sensor>
    </joint>
<!-- UAV FRAME END -->


<!-- Sensors and main frame END -->

<!-- Propellers definition -->
    <link name="rotor_0">
        <gravity>true</gravity>
        <self_collide>false</self_collide>
        <velocity_decay/>
        <pose>0.176876 -0.176876 0.450 0 0 0</pose>
